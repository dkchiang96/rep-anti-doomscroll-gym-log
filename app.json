{
  "expo": {
    "name": "rep",
    "slug": "rep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/REP-logo.png",
    "scheme": "rep",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.dc.rep",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/images/REP-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/REP-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0D",
          "image": "./assets/images/REP-logo.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#F2F24B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55461e65-8f76-4b71-af29-36514517104d"
      }
    }
  }
}
